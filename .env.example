# Kamoto environment configuration
# Copy real SMTP credentials here to deliver OTPs by email.

# Server
PORT=3000
SESSION_SECRET=kamoto-dev-secret-change-me-in-production
# NODE_ENV=production

# Demo accounts (owner@kamoto.test / Owner123!, customer@kamoto.test / Customer123!)
# are seeded on start outside production. SEED_DEMO=true/false can override
# that default for development/testing. They are NEVER seeded in production.
# SEED_DEMO=true

# PostgreSQL (Supabase)
# Get these from your Supabase project: Project Settings -> Database -> Connection string.
# Use the "pg" / pooler connection string, e.g.
#   postgresql://postgres.yourproject:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@your-project-host.supabase.co:5432/postgres
# Set to false to disable SSL (not recommended for Supabase)
# DATABASE_SSL=true

# Supabase Storage (image uploads). The secret key is server-side only and
# must never be exposed to the browser. The bucket must be public so images
# can be served directly from the returned URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
SUPABASE_BUCKET=images

# SMTP (used for OTP email verification).
# Gmail example: requires a Google App Password (2-Step Verification enabled):
#   Google Account -> Security -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=Kamoto <your.email@gmail.com>

# OTP behaviour (optional overrides)
# OTP_TTL_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PENDING=5
# OTP_MAX_ATTEMPTS=5
