<% if (typeof currentUser === 'undefined') { currentUser = null; } %>
<% if (typeof flash === 'undefined') { flash = {}; } %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title === 'Kamoto' ? 'Kamoto' : 'Kamoto | ' + title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="leaves" aria-hidden="true">
    <div class="leaf"></div>
    <div class="leaf"></div>
    <div class="leaf"></div>
    <div class="leaf"></div>
    <div class="leaf"></div>
  </div>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="topbar-brand">
        <span class="brand-logo">🍃</span>
        <span class="brand-name">Kamoto</span>
      </a>

      <nav class="topbar-nav" id="topbarNav" aria-label="Main navigation">
        <div class="dropdown">
          <a href="#" class="nav-item has-chevron">Product <span class="chevron">▾</span></a>
          <div class="dropdown-menu">
            <span class="dropdown-label">Product</span>
            <a href="https://github.com/sureshkannanrk/Flutter-Dart--Frontend/tree/Two-player-Game" target="_blank" rel="noopener">Two Player Game</a>
            <a href="https://github.com/sureshkannanrk/Flutter-Dart--Frontend/tree/Wheather_app" target="_blank" rel="noopener">Weather App</a>
          </div>
        </div>
        <div class="dropdown">
          <a href="#" class="nav-item has-chevron">Developers <span class="chevron">▾</span></a>
          <div class="dropdown-menu">
            <span class="dropdown-label">Developers</span>
            <a href="https://www.linkedin.com/in/suresh367" target="_blank" rel="noopener">My LinkedIn</a>
          </div>
        </div>
        <% if (currentUser && currentUser.role === 'owner') { %>
          <a href="/restaurants/new" class="nav-item">Add Restaurant</a>
        <% } %>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/admin/restaurants" class="nav-item">Admin Portal</a>
        <% } %>
        <% if (!currentUser || currentUser.role === 'customer') { %>
          <a href="/register?role=owner" class="nav-item">Your Restaurant</a>
        <% } %>
      </nav>

      <div class="topbar-right">
        <a href="https://github.com/sureshkannanrk?tab=repositories" class="github-link" target="_blank" rel="noopener" aria-label="GitHub repositories">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          <span class="github-count">GitHub</span>
        </a>

        <a href="/dashboard" class="btn dashboard-btn">Dashboard</a>

        <% if (currentUser) { %>
          <a href="/profile" class="profile-btn" title="My Profile" aria-label="My Profile">
            <% if (imageUrl(currentUser.avatar_url)) { %>
              <img class="avatar avatar-sm" src="<%= imageUrl(currentUser.avatar_url) %>" alt="" />
            <% } else { %>
              <span class="avatar avatar-sm placeholder-avatar">👤</span>
            <% } %>
          </a>
          <form method="post" action="/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
          </form>
        <% } else { %>
          <a href="/login" class="nav-item auth-link">Log in</a>
          <a href="/register" class="btn btn-primary btn-sm">Sign up</a>
        <% } %>
      </div>

      <button class="hamburger" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="mobile-menu" id="mobileMenu">
      <a href="/" class="nav-item">Home</a>
      <span class="nav-item dropdown-label">Product</span>
      <a href="https://github.com/sureshkannanrk/Flutter-Dart--Frontend/tree/Two-player-Game" target="_blank" rel="noopener" class="nav-item">Two Player Game</a>
      <a href="https://github.com/sureshkannanrk/Flutter-Dart--Frontend/tree/Wheather_app" target="_blank" rel="noopener" class="nav-item">Weather App</a>
      <span class="nav-item dropdown-label">Developers</span>
      <a href="https://www.linkedin.com/in/suresh367" target="_blank" rel="noopener" class="nav-item">My LinkedIn</a>
      <a href="https://github.com/sureshkannanrk?tab=repositories" target="_blank" rel="noopener" class="nav-item">GitHub</a>
      <a href="/dashboard" class="nav-item">Dashboard</a>
      <% if (currentUser && currentUser.role === 'owner') { %>
        <a href="/restaurants/new" class="nav-item">Add Restaurant</a>
      <% } %>
      <% if (!currentUser || currentUser.role === 'customer') { %>
        <a href="/register?role=owner" class="nav-item">Your Restaurant</a>
      <% } %>
      <% if (currentUser) { %>
        <a href="/profile" class="nav-item">My Profile</a>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-ghost btn-sm btn-block">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav-item">Log in</a>
        <a href="/register" class="btn btn-primary btn-sm btn-block">Sign up</a>
      <% } %>
    </div>
  </header>

  <main class="container">
    <% if (flash && flash.message) { %>
      <div class="flash flash-<%= flash.type %>" role="alert">
        <%= flash.message %>
      </div>
    <% } %>
