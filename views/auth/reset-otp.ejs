<%- include('../partials/header') %>

<section class="auth-card card">
  <h1>Verify your email</h1>
  <p class="muted">We sent a 6-digit code to <strong><%= maskedEmail %></strong>.
     Enter it below to reset your Kamoto password.</p>

  <% if (devOtp) { %>
    <div class="dev-hint">
      <strong>Development mode:</strong> no SMTP server is configured, so your code is shown below.
      <span class="dev-otp"><%= devOtp %></span>
    </div>
  <% } %>

  <% if (errors.form) { %><div class="flash flash-error" role="alert"><%= errors.form %></div><% } %>

  <form method="post" action="/forgot-password/verify" class="form-card" data-validate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="field">
      <label for="otp">Verification code</label>
      <input id="otp" name="otp" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
             placeholder="123456" required autocomplete="one-time-code" />
      <% if (errors.otp) { %><p class="field-error"><%= errors.otp %></p><% } %>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Verify code</button>
  </form>

  <form method="post" action="/forgot-password/resend" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button type="submit" class="btn btn-ghost btn-sm btn-block" style="margin-top:10px">Resend code</button>
  </form>

  <p class="auth-alt">Need a different account? <a href="/forgot-password">Start over</a></p>
</section>

<%- include('../partials/footer') %>
