<%- include('../partials/header') %>

<section class="auth-card card">
  <h1>Forgot your password?</h1>
  <p class="muted">Enter the email address linked to your Kamoto account. We'll email you a 6-digit code to reset your password.</p>

  <% if (message) { %>
    <div class="flash flash-<%= message.type %>" role="alert"><%= message.text %></div>
  <% } %>

  <form method="post" action="/forgot-password" class="form-card" data-validate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" maxlength="255" value="<%= email %>" required />
      <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Send reset code</button>
  </form>

  <p class="auth-alt">Remembered it? <a href="/login">Log in</a></p>
</section>

<%- include('../partials/footer') %>
